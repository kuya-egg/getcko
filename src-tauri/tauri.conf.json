{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetCko",
  "version": "0.1.0",
  "identifier": "com.getcko",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GetCko",
        "width": 1100,
        "height": 760
      },
      {
        "label": "overlay",
        "title": "GetCko overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "contentProtected": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
